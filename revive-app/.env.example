# Safe browser configuration for opt-in Supabase mode.
VITE_REV_PROVIDER_MODE=mock
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Trusted server only. Never prefix provider secrets with VITE_ and never expose them to React.
DATAFORSEO_API_LOGIN=server-only-api-login
DATAFORSEO_API_PASSWORD=server-only-generated-api-password
REV_PROVIDER_TEST_BUDGET_GBP=10
REV_PROVIDER_GLOBAL_ALLOWANCE_GBP=10
REV_PROVIDER_RATE_LIMIT_PER_MINUTE=5
